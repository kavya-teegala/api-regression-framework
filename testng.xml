<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Test Suite" parallel="tests" thread-count="3">

    <listeners>
        <listener class-name="com.framework.regressionframework.utils.TestListener"/>
    </listeners>

    <test name="TestSuite">
        <classes>
            <class name="com.framework.regressionframework.tests.LoginTest"/>
            <class name="com.framework.regressionframework.tests.UserAPITest"/>
            <class name="com.framework.regressionframework.tests.TestCaseApiTest"/>
            <class name="com.framework.regressionframework.tests.ui.DemoFailureTest"/>
        </classes>
    </test>

</suite>